class Coche:
    def __init__(self, marca, modelo, anio):
        self.marca = marca
        self.modelo = modelo
        self.anio = anio

    def obtener_marca(self):
        return self.marca

    def establecer_marca(self, marca):
        self.marca = marca

    def obtener_modelo(self):
        return self.modelo

    def establecer_modelo(self, modelo):
        self.modelo = modelo

    def obtener_anio(self):
        return self.anio

    def establecer_anio(self, anio):
        self.anio = anio

    def calcular_antiguedad(self):
        return 2025 - self.anio


if __name__ == "__main__":
    coche1 = Coche("Toyota", "Corolla", 2020)

    print("Marca:", coche1.obtener_marca())
    print("Modelo:", coche1.obtener_modelo())
    print("Año:", coche1.obtener_anio())
    print("Antigüedad:", coche1.calcular_antiguedad())

    coche1.establecer_anio(2018)

    print("\nDespués de actualizar:")
    print("Año:", coche1.obtener_anio())
    print("Antigüedad:", coche1.calcular_antiguedad())
